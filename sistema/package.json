{
  "name": "babycaleb-sistema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p panel",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "test:node": "vitest run -c vitest.node.config.ts",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "tipos": "wrangler types",
    "migraciones:local": "wrangler d1 migrations apply babycaleb-db --local",
    "migraciones:staging": "wrangler d1 migrations apply babycaleb-db-staging --remote --env staging",
    "migraciones:prod": "wrangler d1 migrations apply babycaleb-db --remote --env production",
    "huella": "vitest run src/contrato/huella.test.ts",
    "contrato": "vitest run src/contrato",
    "panel:dev": "vite --config panel/vite.config.ts",
    "panel:build": "vite build --config panel/vite.config.ts",
    "panel:muestra": "node scripts/panel-de-muestra.mjs",
    "panel:auditar": "node scripts/auditar-panel.mjs",
    "cables": "node scripts/cables.mjs"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/runner": "~4.1.12",
    "@vitest/snapshot": "~4.1.12",
    "playwright": "^1.58.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.7",
    "vitest": "~4.1.12",
    "wrangler": "^4.159.0"
  }
}
