{
  // `babycaleb-web`: la web servida desde Cloudflare (F1 del plan).
  //
  // `SISTEMA` entra aquí en F3.5: es por donde la web pide el catálogo. `CRM`
  // sigue sin estar y entra en F3.6, cuando el chat pase a `CanalWeb`: un
  // binding a un entrypoint que no existe impide desplegar, así que cada uno
  // llega con la fase que lo crea.
  //
  // Apunta a `babycaleb-sistema-staging` A PROPÓSITO: `babycaleb-sistema` (el
  // de producción) todavía no existe, y esta web vive en workers.dev como
  // copia de prueba. Se cambia en el traspaso (F3.4), junto con el DNS.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babycaleb-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "services": [
    { "binding": "SISTEMA", "service": "babycaleb-sistema-staging", "entrypoint": "SistemaWeb" }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // La web es una SPA: cualquier ruta que no sea un archivo devuelve
    // index.html y el enrutador del navegador decide qué pintar.
    "not_found_handling": "single-page-application",
    // El Worker corre primero SOLO donde hace falta. Todo lo demás —imágenes,
    // JavaScript, hojas de estilo— sale directo del borde sin pagar un Worker.
    "run_worker_first": [
      "/api/*",
      "/",
      "/productos",
      "/productos/*",
      "/beneficios",
      "/historia",
      "/tips",
      "/como-comprar",
      "/faq",
      "/seguimiento/*",
      "/carrito",
      "/mi-cuenta/*",
      "/pedido/*"
    ]
  },

  // SITE_URL manda sobre el `Host` de la petición: con el Host, el canónico de
  // una vista previa apuntaría a la vista previa y Google indexaría esa.
  // Se queda vacío hasta que exista babycaleb.com (F0.1); vacío, se usa el
  // origen de la petición, que es lo correcto mientras se prueba en workers.dev.
  // CF_ANALYTICS_TOKEN: el identificador de Cloudflare Web Analytics (F1.8).
  // Vacío, no se inyecta nada — que es lo que se quiere mientras esto sea una
  // vista previa, para no contar visitas de prueba como si fueran clientas.
  "vars": { "VERSION": "dev", "SITE_URL": "", "CF_ANALYTICS_TOKEN": "" }

  // Secretos: GROQ_API_KEY (wrangler secret put GROQ_API_KEY)
}
