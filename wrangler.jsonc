{
  // `babycaleb-web`: la web servida desde Cloudflare (F1 del plan).
  //
  // `SISTEMA` entra aquí en F3.5: es por donde la web pide el catálogo. `CRM`
  // sigue sin estar y entra en F3.6, cuando el chat pase a `CanalWeb`: un
  // binding a un entrypoint que no existe impide desplegar, así que cada uno
  // llega con la fase que lo crea.
  //
  // Apunta a `babycaleb-sistema` (PRODUCCIÓN) desde el 2026-11-11.
  //
  // Hasta ese día apuntaba a staging a propósito, porque el Worker de
  // producción no existía. Ahora existe, tiene su puerta de Access, su D1 con
  // el catálogo y sus usuarios, así que esta web lee de la MISMA base que ve
  // la dueña en el panel. Eso es lo que hace que cambiar un precio o publicar
  // un producto se note en la tienda sin desplegar nada.
  //
  // Antes del cambio, los 12 productos se publicaron en la D1 de producción
  // para que coincidiera con lo que las clientas YA veían: los mismos códigos
  // y los mismos precios que staging servía, al centavo. Sin eso, el cambio
  // de binding habría dejado la tienda vacía en el momento de desplegar.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "babycaleb-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "services": [
    { "binding": "SISTEMA", "service": "babycaleb-sistema", "entrypoint": "SistemaWeb" }
  ],

  // El límite del chat, por IP. 15 por minuto: una clienta entusiasmada manda
  // cinco o seis; un script manda cientos. Lo cuenta Cloudflare en el borde,
  // así que una petición bloqueada no llega a costar nada en el proveedor del
  // modelo — que es el punto.
  "ratelimits": [
    { "name": "LIMITE_CHAT", "namespace_id": "2001", "simple": { "limit": 15, "period": 60 } }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // La web es una SPA: cualquier ruta que no sea un archivo devuelve
    // index.html y el enrutador del navegador decide qué pintar.
    "not_found_handling": "single-page-application",
    // El Worker corre primero SOLO donde hace falta. Todo lo demás —imágenes,
    // JavaScript, hojas de estilo— sale directo del borde sin pagar un Worker.
    "run_worker_first": [
      "/api/*",
      // Las fotos del catálogo, las que suben desde el panel.
      //
      // `/foto/` y NO `/img/`: `/img/` ya es de las imágenes del sitio (las 26
      // de `public/img/`), y ponerle el Worker delante las dejó TODAS rotas en
      // producción — las buscaba en R2, donde no están. Un prefijo propio no
      // se comparte con nadie.
      //
      // Hace falta estar en esta lista: sin ella la petición la atiende
      // primero el servidor de archivos estáticos, no encuentra nada, cae en
      // `single-page-application` y devuelve el index.html de la web. Cada
      // foto llegaría como una página HTML, con un 200 y todo.
      "/foto/*",
      // El enlace corto de una ficha, `/p/<slug>`.
      //
      // El Worker sabe redirigirlo a `/productos/<slug>` desde hace días, y no
      // servía de NADA: sin estar en esta lista, la petición la atiende primero
      // el servidor de archivos, no encuentra `/p/...`, cae en
      // `single-page-application` y devuelve el index.html. Quien recibía un
      // enlace compartido veía una página con cabecera, pie y nada en medio —
      // con un 200, que es lo que lo hacía invisible.
      //
      // Es EXACTAMENTE lo que avisa el comentario de `/foto/*` aquí arriba. La
      // lección estaba escrita al lado y aun así volvió a pasar: por eso ahora
      // hay una prueba que compara las rutas que el Worker atiende con esta
      // lista (`worker/enlace-corto.test.ts`).
      "/p/*",
      "/",
      "/productos",
      "/productos/*",
      "/beneficios",
      "/historia",
      "/tips",
      "/como-comprar",
      "/faq",
      "/privacidad",
      "/terminos",
      "/seguimiento/*",
      "/carrito",
      "/mi-cuenta/*",
      "/pedido/*"
    ]
  },

  // babycaleb.com, conectado el 2026-11-10. `www` NO entra aquí: el Worker lo
  // redirige con un 301 a la raíz (F1.9), porque dos direcciones con el mismo
  // contenido reparten entre ellas lo que debería ir a una sola.
  // La raíz como dominio propio, y `www` como RUTA.
  //
  // La diferencia importa: un dominio propio necesita crear su registro DNS, y
  // en `www` ya hay un CNAME que apunta a la raíz. Con el Worker en la raíz,
  // Cloudflare intenta usarla como el servidor que hay detrás y se queda
  // esperando: error 522. Una ruta no crea ningún registro — intercepta lo que
  // ya pasa por ahí, porque ese CNAME está proxiado—, así que convive con él y
  // el Worker contesta su 301 a la raíz (F1.9).
  "routes": [
    { "pattern": "babycaleb.com", "custom_domain": true },
    { "pattern": "www.babycaleb.com/*", "zone_name": "babycaleb.com" }
  ],

  // SITE_URL manda sobre el `Host` de la petición: con el Host, el canónico de
  // una vista previa apuntaría a la vista previa y Google indexaría esa.
  // CF_ANALYTICS_TOKEN: el identificador de Cloudflare Web Analytics (F1.8).
  // Vacío, no se inyecta nada — que es lo que se quiere mientras esto sea una
  // vista previa, para no contar visitas de prueba como si fueran clientas.
  //
  // INDEXABLE: APAGADO a propósito. El dominio se conectó ANTES de estar listo
  // para buscadores —los precios salen todavía de la base de PRUEBAS y no
  // existen las páginas legales— así que el sitio sirve pero Google no lo
  // guarda. Se enciende poniendo "si", y entonces entra a Google todo el SEO
  // que ya está hecho: fichas por producto, JSON-LD, sitemap y <head> por ruta.
  //
  // Condiciones para encenderlo, las tres:
  //   1. `babycaleb-sistema` (producción) existe y la web apunta a él;
  //      ✅ desde el 2026-11-11.
  //   2. Yarielis aprobó los precios y el catálogo está publicado;
  //      El catálogo ya está publicado (12 de 12). La APROBACIÓN de los
  //      precios es de ella y nadie más la puede dar: sigue pendiente.
  //   3. existen las páginas legales (Ley 81). ✅ F1.7.
  //
  // El estado sale en /api/salud y el chequeo del despliegue lo dice en voz
  // alta cada vez: un sitio lanzado y olvidado en «oculto» no da ningún
  // síntoma, simplemente no llega nadie.
  "vars": {
    "VERSION": "dev",
    "SITE_URL": "https://babycaleb.com",
    "CF_ANALYTICS_TOKEN": "",
    "INDEXABLE": ""
  }

  // Secretos: GROQ_API_KEY (wrangler secret put GROQ_API_KEY)
}
