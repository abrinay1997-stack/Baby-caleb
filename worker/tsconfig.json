{
  // El Worker vive en otro mundo que la web: ahí no hay `document` ni
  // `window`, y sí hay `HTMLRewriter`, `Fetcher` y `caches.default`. Por eso
  // tiene su propio tsconfig con los tipos de Workers y sin la librería DOM.
  //
  // Comparte `src/seo/rutas.ts` con la web, que es dato puro y no toca ninguno
  // de los dos entornos: por eso se puede leer desde aquí.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `@cloudflare/vitest-plugin/types` trae `cloudflare:test`, que es de donde
    // sale `SELF` — el Worker entero montado de verdad. Hace falta porque hay
    // una prueba que comprueba una RUTA y no un módulo suelto: que
    // `/api/salud` le pregunte al sistema no se puede ver llamando a una
    // función, solo pidiéndole la ruta al Worker. Sin esto el tipo no existe y
    // `npm run lint` se cae aunque la prueba pase.
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/seo/**/*.ts"]
}
